{
    "openapi": "3.0.0",
    "info": {
        "title": "Book Directory API",
        "description": "API documentation for the Cart API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080/api",
            "description": "Local development server"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Authenticate user",
                "description": "Authenticate a user using email and password and issue an access token.",
                "operationId": "8e026335d25c3df3f6f6cf1f683ac7b8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginUserRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User authenticated successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AuthResponse"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid credentials or validation error."
                    }
                }
            }
        },
        "/auth/logout": {
            "delete": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout user",
                "description": "Revoke the current access token for the authenticated user.",
                "operationId": "23a3ec5e2e8d20c9fd2ea568ae96fcd3",
                "responses": {
                    "204": {
                        "description": "User logged out successfully."
                    },
                    "401": {
                        "description": "User is unauthenticated."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Get current user",
                "description": "Return the currently authenticated user.",
                "operationId": "a27984a716a6787c8b8537aee958673c",
                "responses": {
                    "200": {
                        "description": "User retrieved successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResponse"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "User is unauthenticated."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register user",
                "description": "Register a new user and issue an access token.",
                "operationId": "8e69ddc577b1650c4a010f798dd6c9d3",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterUserRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AuthResponse"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error."
                    }
                }
            }
        },
        "/authors": {
            "get": {
                "tags": [
                    "Authors"
                ],
                "summary": "Get list of authors",
                "description": "Retrieve a paginated list of authors with filters and sorting.",
                "operationId": "6e791cab4f6d9bd496a9d5ddd05fdb24",
                "parameters": [
                    {
                        "name": "filter[search]",
                        "in": "query",
                        "description": "Search by last_name, first_name, patronymic or biography.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by author fields.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "created_at",
                                "-created_at",
                                "full_name",
                                "-full_name",
                                "birth_date",
                                "-birth_date",
                                "death_date",
                                "-death_date"
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Author list retrieved successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/AuthorResponse"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    },
                    {}
                ]
            }
        },
        "/users/{user}/role": {
            "put": {
                "tags": [
                    "Users"
                ],
                "summary": "Update user role",
                "description": "Update role of the specified user.",
                "operationId": "4850dab8bab4efcf811ea32bd7ac050d",
                "parameters": [
                    {
                        "name": "user",
                        "in": "path",
                        "description": "User identifier (id)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateUserRoleRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User details retrieved successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResponse"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "User does not have permissions."
                    },
                    "404": {
                        "description": "User not found."
                    },
                    "422": {
                        "description": "Validation error."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/users": {
            "get": {
                "tags": [
                    "Users"
                ],
                "summary": "Get list of users",
                "description": "Retrieve a paginated list of users with filters and sorting.",
                "operationId": "bda0424acf687003f1427ea721f28c1b",
                "parameters": [
                    {
                        "name": "filter[search]",
                        "in": "query",
                        "description": "Search by name or email.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "filter[role]",
                        "in": "query",
                        "description": "Filter by user role.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by user fields.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "created_at",
                                "-created_at",
                                "name",
                                "-name"
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User list retrieved successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/UserResponse"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "User does not have permissions."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/users/{user}": {
            "get": {
                "tags": [
                    "Users"
                ],
                "summary": "Get user details",
                "description": "Retrieve detailed information for a specific user.",
                "operationId": "5d070ea37265b50551f44596d2508cda",
                "parameters": [
                    {
                        "name": "user",
                        "in": "path",
                        "description": "User identifier (id)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User details retrieved successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResponse"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "User does not have permissions."
                    },
                    "404": {
                        "description": "User not found."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Users"
                ],
                "summary": "Delete user",
                "description": "Permanently remove the specified user from the database.",
                "operationId": "f5763f7370dc575bb7d88d3e39f34e43",
                "parameters": [
                    {
                        "name": "user",
                        "in": "path",
                        "description": "User identifier (id)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "User deleted successfully."
                    },
                    "401": {
                        "description": "User does not have permissions."
                    },
                    "404": {
                        "description": "User not found."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "LoginUserRequest": {
                "title": "Login User Request",
                "description": "Request payload for authenticating a user.",
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "description": "User email address.",
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com",
                        "maxLength": 255
                    },
                    "password": {
                        "description": "User account password.",
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    }
                },
                "type": "object"
            },
            "RegisterUserRequest": {
                "title": "Register User Request",
                "description": "Request payload for registering a new user.",
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "name": {
                        "description": "Full name of the user.",
                        "type": "string",
                        "example": "John Doe",
                        "maxLength": 100,
                        "minLength": 3
                    },
                    "email": {
                        "description": "User email address.",
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com",
                        "maxLength": 255
                    },
                    "password": {
                        "description": "User account password.",
                        "type": "string",
                        "format": "password",
                        "example": "password123",
                        "minLength": 8
                    },
                    "password_confirmation": {
                        "description": "Password confirmation (must match password).",
                        "type": "string",
                        "format": "password",
                        "example": "password123",
                        "minLength": 8
                    }
                },
                "type": "object"
            },
            "UpdateUserRoleRequest": {
                "title": "Update User Role Request",
                "description": "Request payload for updating of the specified user.",
                "required": [
                    "role"
                ],
                "properties": {
                    "role": {
                        "description": "Role of the user.",
                        "type": "string",
                        "example": "editor",
                        "enum": [
                            "viewer",
                            "editor",
                            "admin"
                        ]
                    }
                },
                "type": "object"
            },
            "AuthResponse": {
                "title": "Auth Response",
                "description": "Data returned after user login or registration.",
                "required": [
                    "user",
                    "access_token",
                    "token_type"
                ],
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/UserResponse"
                    },
                    "access_token": {
                        "description": "Personal access token for API authentication.",
                        "type": "string",
                        "example": "1|eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                    },
                    "token_type": {
                        "description": "Token type to be used in the Authorization header.",
                        "type": "string",
                        "example": "Bearer"
                    }
                },
                "type": "object"
            },
            "UserResponse": {
                "title": "User Response",
                "description": "Data of a specific user.",
                "required": [
                    "id",
                    "name",
                    "email"
                ],
                "properties": {
                    "id": {
                        "description": "Unique identifier of the user.",
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "description": "Full name of the user.",
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "description": "Email address of the user.",
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "role": {
                        "description": "Role of the user.",
                        "type": "string",
                        "example": "viewer",
                        "enum": [
                            "viewer",
                            "editor",
                            "admin",
                            "super-admin"
                        ]
                    }
                },
                "type": "object"
            },
            "AuthorResponse": {
                "title": "Author Response",
                "description": "Data of a specific author.",
                "required": [
                    "id",
                    "last_name",
                    "first_name",
                    "slug"
                ],
                "properties": {
                    "id": {
                        "description": "Unique identifier of the author.",
                        "type": "integer",
                        "example": 1
                    },
                    "last_name": {
                        "description": "Lastname of the author.",
                        "type": "string",
                        "example": "Shevchenko"
                    },
                    "first_name": {
                        "description": "Firstname of the author.",
                        "type": "string",
                        "example": "Taras"
                    },
                    "patronymic": {
                        "description": "Patronymic of the author.",
                        "type": "string",
                        "example": "Grigorievich",
                        "nullable": true
                    },
                    "slug": {
                        "description": "Slug of the author.",
                        "type": "string",
                        "example": "shevchenko-taras-grigorievich"
                    },
                    "birth_date": {
                        "description": "Birth date of the author.",
                        "type": "string",
                        "format": "date",
                        "example": "1814-03-09",
                        "nullable": true
                    },
                    "death_date": {
                        "description": "Death date of the author.",
                        "type": "string",
                        "format": "date",
                        "example": "1861-03-10",
                        "nullable": true
                    },
                    "biography": {
                        "description": "Biography of the author.",
                        "type": "string",
                        "example": "Ukrainian poet, artist, and thinker. Born into a family of serfs, he gained his freedom through a ransom. His work became the foundation of modern Ukrainian literature.",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Enter token in format: Bearer {token}",
                "name": "Authorization",
                "in": "header",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Authors",
            "description": "Authors"
        },
        {
            "name": "Users",
            "description": "Users"
        }
    ]
}